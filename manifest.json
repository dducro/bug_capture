{
  "manifest_version": 3,
  "name": "Bug Capture",
  "version": "1.0.0",
  "description": "Record interactions and export Markdown bug reports",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/tracker.js"],
      "run_at": "document_idle"
    }
  ]
}
